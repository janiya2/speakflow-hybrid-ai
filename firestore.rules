rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for secure role-based access control
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // High-security Admin Check: strictly validates known admin emails to prevent privilege escalation
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email in ['janithad2@gmail.com', 'admin@speakflow.ai'] ||
        (exists(/databases/$(database)/documents/lang_users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/lang_users/$(request.auth.uid)).data.role == 'admin' &&
         request.auth.token.email in ['janithad2@gmail.com', 'admin@speakflow.ai'])
      );
    }

    // 1. SpeakFlow Topics & Scenarios (Public catalog browse, admin-only authoring)
    match /lang_topics/{topicId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 2. SpeakFlow Settings & AI Configuration
    match /lang_settings/{settingId} {
      // Sensitive AI and billing credentials: Admin Only; plans and time limits readable by authenticated users
      allow read: if (settingId != 'ai_config' && isSignedIn()) || isAdmin();
      allow write: if isAdmin();
    }

    // 3. User Accounts, Practice Minutes & Streaks
    // Authenticated read for leaderboard rankings and progress tracking
    // Strict guards prevent privilege escalation (cannot forge role: 'admin')
    match /lang_users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) && (!('role' in request.resource.data) || request.resource.data.role != 'admin');
      allow update: if (
        isOwner(userId) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']) || isAdmin())
      ) || isAdmin();
      allow delete: if isAdmin();
    }

    // 4. Completed Voice Call Sessions & Evaluation Logs
    // Authenticated users can view sessions and create sessions ONLY for their own verified userId
    match /lang_sessions/{sessionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
    }

    // 5. Push Notifications Log
    match /lang_notifications/{notificationId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Default deny for unmapped root paths unless explicitly authenticated
    match /{document=**} {
      allow read: if isSignedIn() || isAdmin();
      allow write: if isAdmin();
    }
  }
}
