rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for secure role-based access control
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email in ['janithad2@gmail.com', 'admin@speakflow.ai'] ||
        (exists(/databases/$(database)/documents/lang_users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/lang_users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // 1. SpeakFlow Topics & Scenarios (Public catalog browse, admin-only authoring)
    match /lang_topics/{topicId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 2. SpeakFlow Settings & AI Configuration
    match /lang_settings/{settingId} {
      // Sensitive AI and billing credentials: Admin Only; plans and time limits readable by all
      allow read: if settingId != 'ai_config' || isAdmin();
      allow write: if isAdmin();
    }

    // 3. User Accounts, Practice Minutes & Streaks
    // Public read for leaderboard student names/XP
    // Allow users to update their own profile, learning preferences, stats, and VIP subscriptions
    match /lang_users/{userId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if (
        isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])
      ) || isAdmin();
      allow delete: if isAdmin();
    }

    // 4. Completed Voice Call Sessions & Evaluation Logs
    // Readable for leaderboard and grammar review
    match /lang_sessions/{sessionId} {
      allow read: if isSignedIn() || isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
    }

    // 5. Push Notifications Log
    match /lang_notifications/{notificationId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Default deny for unmapped root paths unless authenticated
    match /{document=**} {
      allow read: if isSignedIn() || isAdmin();
      allow write: if isAdmin();
    }
  }
}
