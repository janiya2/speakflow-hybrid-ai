rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for secure role-based access control
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email in ['janithad2@gmail.com', 'admin@speakflow.ai'] ||
        (exists(/databases/$(database)/documents/lang_users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/lang_users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // 1. SpeakFlow Topics & Scenarios (Public catalog browse, admin-only authoring)
    match /lang_topics/{topicId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 2. SpeakFlow Settings & AI Configuration
    match /lang_settings/{settingId} {
      // Sensitive AI and billing credentials: Strictly Admin Only
      allow read, write: if settingId == 'ai_config' ? isAdmin() : (isSignedIn() || isAdmin());
    }

    // 3. User Accounts, Practice Minutes & Streaks
    // Prevents Client-Side Privilege Escalation: Regular users CANNOT modify 'role', 'isPro', or 'isVipMonthly'
    match /lang_users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && (
        !request.resource.data.keys().hasAny(['role', 'isPro', 'isVipMonthly']) || isAdmin()
      );
      allow update: if (
        isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isPro', 'isVipMonthly'])
      ) || isAdmin();
      allow delete: if isAdmin();
    }

    // 4. Completed Voice Call Sessions & Evaluation Logs
    // Strictly Owner-only isolation (A user can only read and log their own conversation sessions)
    match /lang_sessions/{sessionId} {
      allow read: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
    }

    // 5. Push Notifications Log
    match /lang_notifications/{notificationId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Default deny for unmapped root paths unless authenticated
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
